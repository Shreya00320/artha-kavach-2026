# LLM Provider: 'gemini' or 'mock'
LLM_PROVIDER=

# API Key for chosen provider (required for 'gemini')
LLM_API_KEY=

# Model name: Choose a current Gemini Flash model from Google AI Studio
LLM_MODEL=

# Embedding model for retrieval
EMBEDDING_MODEL=

# Generation settings (optional overrides)
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
LLM_CACHE_ENABLED=
LLM_CACHE_DIR=
