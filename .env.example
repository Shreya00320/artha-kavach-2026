# ── LLM provider ──────────────────────────────────────────────────
# 'gemini' (default), 'groq' (free: https://console.groq.com) or 'mock' (offline tests)
LLM_PROVIDER=gemini

# Google AI Studio API key — get one free at https://aistudio.google.com
GEMINI_API_KEY=your_key_here

# Groq key (used when LLM_PROVIDER=groq; LLM_MODEL defaults to openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_key_here

# Gemini model for generation (flash is fast and free-tier friendly).
# Check https://aistudio.google.com/docs/deprecations — gemini-2.0-flash and
# text-embedding-004 have been shut down.
LLM_MODEL=gemini-3.8-flash

# ── Embeddings (for RAG / knowledge base) ─────────────────────────
EMBEDDING_MODEL=gemini-embedding-001

# ── Optional tuning ───────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Cache LLM responses to disk (true = save API cost on reruns)
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm
